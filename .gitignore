# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
env/
.venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project-specific
data/*.csv
data/*.parquet
# Ignore bulky regenerable CSVs, but KEEP the experiment finding reports (.txt)
# so reviewers can see results on GitHub without running anything.
results/*.csv
results/*.png
!results/.gitkeep
# (results/*.txt are intentionally committed)

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
